# URL запущенного OSSO CRM без завершающего слеша.
# Локально CRM запускается командой: npm run dev -- -p 3001
CRM_API_URL=http://localhost:3001
# Должен совпадать с STORE_API_KEY на production-сервере CRM.
CRM_API_KEY=
# Курс для отображения CRM-цен в мобильном приложении (USD → UZS).
USD_TO_UZS_RATE=12500

# Данные входа в панель. Используйте длинный уникальный пароль и секрет.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
# Аварийный ключ для сброса пароля через API /api/auth/recover.
ADMIN_RECOVERY_KEY=replace-with-another-long-random-key
CUSTOMER_SESSION_SECRET=replace-with-a-long-random-customer-secret

# Онлайн-оплата CLICK. Значения выдаёт CLICK для вашего договора/сервиса.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# Публичный HTTPS-адрес, куда CLICK вернёт покупателя после оплаты.
CLICK_RETURN_URL=https://your-domain.uz/payment/result
# Обычно менять не нужно.
CLICK_PAYMENT_URL=https://my.click.uz/services/pay
